# Copia este archivo como .env.local y completa los valores.
# Supabase → Project Settings → API / API Keys.
# Usa SOLO la clave publishable (o anon). Nunca la service_role/secret.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# SOLO DESARROLLO: true muestra 3 propiedades ficticias de ejemplo en el inicio.
# No tiene efecto en producción (el build no incluye los datos de ejemplo).
# No la configures en Cloudflare.
VITE_USE_FIXTURES=
